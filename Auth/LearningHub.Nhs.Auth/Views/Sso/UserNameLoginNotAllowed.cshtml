@model LearningHub.Nhs.Auth.Models.Account.UserEmailViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/LearningHub/_Layout.cshtml";
    ViewData["DisableValidation"] = true;
}

<div class="nhsuk-width-container app-width-container">
    <div class="nhsuk-grid-row">
        <div class="nhsuk-grid-column-full nhsuk-u-padding-top-7 nhsuk-u-padding-bottom-5">
            <div class="nhsuk-grid-column-full">
                <h1 class="nhsuk-heading-xl">@ViewData["Title"]</h1>
                <div>
                    <p>
                        You entered your username: <b>@Model.UserName</b>
                    </p>
                    <p>
                        Sign in using your email address instead:
                        <span id="email-address">@Model.Email</span>
                        <a href="#" id="copy-email">[Copy email address]</a>

                        <span id="copy-status"
                              class="nhsuk-u-visually-hidden"
                              role="status"
                              aria-live="polite"></span>
                    </p>

                    <p>Your password has not changed.</p>
                    <p>If you use a password manager, update it to use your email address instead of your username.</p>
                    <p>
                        <a asp-action="BackToSignIn" asp-controller="Sso" asp-route-redirectUrl="@Model.RedirectUrl" asp-route-clientCode="@Model.ClientCode" asp-route-secretkey="@Model.SecretKey" asp-route-Email="@Model.UserName" class="nhsuk-button">Back to sign in</a>
                    </p>
                </div>
            </div>

            @* <div id="maintenance-warning"
                 class="nhsuk-warning-banner"
                 role="region"
                 aria-labelledby="maintenance-warning-title">

                <div class="nhsuk-warning-banner__header">

                    <h2 class="nhsuk-warning-banner__title"
                        id="maintenance-warning-title">
                        You can no longer sign in with your username
                    </h2>
                    <a href="@Model.RedirectUrl"
                       class="nhsuk-warning-banner__close"
                       aria-label="Dismiss warning">
                        ×
                    </a>

                </div>
                <div class="nhsuk-warning-banner__content nhsuk-u-padding-top-5">
                    <p class="nhsuk-u-padding-left-2">
                        You entered your username: <b>@Model.UserName</b>
                    </p>
                    <p class="nhsuk-u-padding-left-2">
                        Sign in using your email address instead:
                        <span id="email-address">@Model.Email</span>
                        <a href="#" id="copy-email">[Copy email address]</a>

                        <span id="copy-status"
                              class="nhsuk-u-visually-hidden"
                              role="status"
                              aria-live="polite"></span>
                    </p>

                    <p class="nhsuk-u-padding-left-2">Your password has not changed.</p>
                    <p class="nhsuk-u-padding-left-2">If you use a password manager, update it to use your email address instead of your username.</p>
                    <p class="nhsuk-u-padding-left-2">
                        <a asp-action="BackToSignIn" asp-controller="Account" asp-route-redirectUrl="@Model.RedirectUrl">Back to sign in</a>
                    </p>
                </div>
            </div> *@
        </div>
    </div>
</div>
<script>
        document.addEventListener('DOMContentLoaded', function () {
        const copyLink = document.getElementById('copy-email');
        const emailAddress = document.getElementById('email-address');
        const copyStatus = document.getElementById('copy-status');

        if (!copyLink || !emailAddress || !copyStatus) {
            return;
        }

        copyLink.addEventListener('click', async function (event) {
            event.preventDefault();

            try {
                await navigator.clipboard.writeText(
                    emailAddress.textContent.trim()
                );

                copyLink.textContent = '[Email address copied]';
                copyStatus.textContent = 'Email address copied';

                setTimeout(function () {
                    copyLink.textContent = '[Copy email address]';
                    copyStatus.textContent = '';
                }, 5000);
            } catch (error) {
                console.error('Unable to copy email address:', error);
                copyStatus.textContent = 'Unable to copy email address';
            }
        });
    });
</script>