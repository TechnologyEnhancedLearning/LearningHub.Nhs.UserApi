@model LearningHub.Nhs.Auth.Models.Account.UserEmailViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/LearningHub/_Layout.cshtml";
    ViewData["DisableValidation"] = true;
}

<div class="nhsuk-width-container app-width-container">
    <div class="nhsuk-grid-row">
        <div class="nhsuk-grid-column-full nhsuk-u-padding-top-7 nhsuk-u-padding-bottom-5">

            <div id="maintenance-warning"
                 class="nhsuk-warning-banner"
                 role="region"
                 aria-labelledby="maintenance-warning-title">

                <div class="nhsuk-warning-banner__header">

                    <h2 class="nhsuk-warning-banner__title"
                        id="maintenance-warning-title">
                        Check your email address
                    </h2>
                    <a href="@Model.RedirectUrl"
                       class="nhsuk-warning-banner__close"
                       aria-label="Dismiss warning">
                        ×
                    </a>

                </div>

                <div class="nhsuk-warning-banner__content nhsuk-u-padding-top-5">
                    <p class="nhsuk-u-padding-left-2">
                        You'll soon sign in using your email address instead of your username.
                    </p>
                    
                    <p class="nhsuk-u-padding-left-2">
                        The email address on your account is: @Model.Email <a href="@Model.MyAccountUrl">[Change email]</a>
                    </p>
                    <p class="nhsuk-u-padding-left-2">Please make sure this email address is correct.</p>
                    @if (Model.HasMultipleUsers)
                    {
                        <p class="nhsuk-u-padding-left-2">
                            This email address is associated with more than 1 account. Only 1 account can use an email address. Other accounts using this email address will be deactivated when email sign-in is introduced.
                        </p>
                        <p class="nhsuk-u-padding-left-2">Update each account with a different email address to keep them active.</p>
                    }
                    <p class="nhsuk-u-padding-left-2">
                        <a href="@Model.RedirectUrl">Dismiss</a>
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>